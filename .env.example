# ローカル開発用(docker-compose.yml が読む)
# コピーして .env を作成する: cp .env.example .env
DB_NAME=appdb
DB_USER=app
DB_PASSWORD=change-me-local

# ---- 本番(docker-compose.prod.yml)でのみ使用 ----
# 講師から払い出された自分のドメインを設定する。アプリは https://${DOMAIN} で公開される。
# このドメインはどの課題リポを公開するときも同じ(課題が変わってもDNS・証明書は不変)
DOMAIN=yamada.example.com
